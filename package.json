{
  "name": "shigotoform",
  "private": true,
  "version": "0.0.8 alpha",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "lint": "biome check src/ tests/ vitest.config.ts && tsc --noEmit",
    "format": "biome format --write src/ tests/ vitest.config.ts",
    "test": "vitest run",
    "test:unit": "vitest run --project unit",
    "test:e2e": "vitest run --project e2e",
    "coverage": "vitest run --coverage",
    "screenshot": "vitest run --project e2e tests/e2e/screenshot.test.ts",
    "act": "act -l",
    "act:build": "act -j build",
    "act:test": "act -j test",
    "act:audit": "act -j audit",
    "act:lint": "act -j lint"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.12",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vite-pwa/workbox-window": "^8.0.0",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/browser-playwright": "^5.0.3",
    "@vitest/coverage-v8": "^5.0.3",
    "fake-indexeddb": "^6.2.5",
    "jsdom": "^30.1.1",
    "playwright": "^1.63.0",
    "typescript": "~7.0.2",
    "vite": "^8.2.2",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^5.0.3"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@fontsource/noto-sans-jp": "^5.3.0",
    "@fontsource/noto-serif-jp": "^5.3.0",
    "@fortawesome/fontawesome-free": "7.3.1",
    "@j1nn0/vanilla-autokana": "^3.0.1",
    "@vitejs/plugin-basic-ssl": "^2.3.0",
    "bootstrap": "^5.3.8",
    "browserslist": "^4.28.9",
    "dexie": "^4.4.5",
    "fast-uri": "^3.1.7",
    "html2pdf.js": "^0.14.0",
    "react": "^19.3.0",
    "react-bootstrap": "^2.10.10",
    "react-dom": "^19.3.0",
    "zod": "^4.6.5"
  },
  "trustedDependencies": [
    "@biomejs/biome",
    "@fortawesome/fontawesome-free",
    "core-js",
    "esbuild"
  ],
  "overrides": {
    "@babel/core": "^7.29.1",
    "@babel/plugin-transform-modules-systemjs": "^7.29.4",
    "brace-expansion": "^5.0.9",
    "fast-uri": "^3.1.5",
    "lodash": "^4.17.24",
    "picomatch": "^2.3.2",
    "serialize-javascript": ">=7.0.3"
  }
}
