{
  "name": "shigotoform",
  "private": true,
  "version": "0.0.6 alpha",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "lint": "biome check src/ && tsc --noEmit",
    "format": "biome format --write src/",
    "test": "playwright test",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:headed": "playwright test --headed",
    "screenshot": "playwright test tests/e2e/screenshot.spec.ts",
    "act": "act -l",
    "act:build": "act -j build",
    "act:test": "act -j test",
    "act:audit": "act -j audit",
    "act:lint": "act -j lint"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.8",
    "@playwright/test": "^1.62.1",
    "@types/bootstrap": "^5.2.11",
    "@vite-pwa/workbox-window": "^8.0.0",
    "typescript": "~5.9.3",
    "vite": "^8.2.1",
    "vite-plugin-pwa": "^1.3.0"
  },
  "dependencies": {
    "@fontsource/noto-sans-jp": "^5.3.0",
    "@fontsource/noto-serif-jp": "^5.3.0",
    "@fortawesome/fontawesome-free": "7.3.1",
    "@vitejs/plugin-basic-ssl": "^2.3.0",
    "bootstrap": "^5.3.8",
    "dexie": "^4.4.4",
    "html2pdf.js": "^0.14.0",
    "vanilla-autokana": "^1.3.0"
  },
  "trustedDependencies": [
    "@biomejs/biome",
    "@fortawesome/fontawesome-free",
    "core-js",
    "esbuild"
  ],
  "overrides": {
    "@babel/core": "^7.29.1",
    "@babel/plugin-transform-modules-systemjs": "^7.29.4",
    "brace-expansion": "^5.0.9",
    "fast-uri": "^3.1.5",
    "lodash": "^4.17.24",
    "picomatch": "^2.3.2",
    "serialize-javascript": ">=7.0.3"
  }
}
